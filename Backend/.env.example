NODE_ENV=development
PORT=4000
# Set to true when OTP verification is implemented; requires x-otp-verification-id on POST /v1/mobile/users
MOBILE_USER_CREATE_REQUIRE_OTP=false
# Comma-separated origins, or * (reflect request origin — dev-friendly; set explicit hosts in production)
CORS_ORIGIN=*
# PostgreSQL connection string (Prisma). Replace yourpassword with your local postgres password.
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/duka_db"
